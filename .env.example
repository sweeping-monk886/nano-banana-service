# ============ Feishu (n8n credential "sora2") ============
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Main bitable (status records)
FEISHU_MAIN_APP_TOKEN=your-main-bitable-app-token
FEISHU_MAIN_TABLE_ID=your-main-bitable-table-id

# Prompt library bitable
FEISHU_LIB_APP_TOKEN=your-prompt-library-app-token
FEISHU_LIB_TABLE_ID=your-prompt-library-table-id

# ============ nano-banana (grsai.dakka.com.cn) ============
NANO_BASE_URL=https://grsai.dakka.com.cn/v1/draw/nano-banana
NANO_API_KEY=sk-your-nano-provider-key
NANO_MODEL=nano-banana-2
NANO_ASPECT_RATIO=9:16
NANO_IMAGE_SIZE=4K
# Keep at 1 to prevent a lost response from causing a second billed generation.
NANO_MAX_ATTEMPTS=1
FEISHU_IMAGE_FORMAT=png
FEISHU_JPEG_QUALITY=95

# Prompt-library row numbers for solid backgrounds. Defaults are 77/78.
WHITE_BACKGROUND_NUMBER=77
BEIGE_BACKGROUND_NUMBER=78

# ============ OpenAI-compatible proxy (for caption / gpt-5.4) ============
OPENAI_BASE_URL=https://your-proxy.example.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT_MS=90000

# Optional OpenAI-compatible fallback for captions. Set these explicitly when
# the image provider does not expose chat completions at /v1.
CAPTION_FALLBACK_BASE_URL=https://your-fallback-proxy.example.com/v1
CAPTION_FALLBACK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CAPTION_FALLBACK_MODEL=gemini-3.5-flash
CAPTION_FALLBACK_TIMEOUT_MS=120000

# Upload all generated images as lossless PNG at the original resolution.
FEISHU_IMAGE_MAX_MB=18

# ============ WeChat Work bot ============
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-webhook-key
WECHAT_NOTIFY_TEXT=图片已生成完毕 @林笙

# ============ Service ============
PORT=3000
# Max records processed per /nano call. 0 = no limit.
MAX_RECORDS_PER_RUN=0
# Concurrency for per-record processing. 2 processes two Feishu records at once.
RECORD_CONCURRENCY=2
LOG_LEVEL=info
